# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for Neon/Supabase: postgresql://postgres:your_password@ep-sample-123.us-east-2.aws.neon.tech/campusconnect?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusconnect?schema=public"

# Authentication & Security
# Generate a secure 32+ character string in production
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# CORS Configuration
# Comma-separated allowed frontend origins (local dev + GitHub Pages URL)
# Example: http://localhost:5173,https://yourusername.github.io
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
